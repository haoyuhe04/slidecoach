# Copy this file to .env and fill in your own provider configuration.
# Include the provider's /v1 or /api/v1 prefix; omit /chat/completions.
SLIDECOACH_PROVIDER=openai-compatible
SLIDECOACH_MODEL_URL=
SLIDECOACH_MODEL=
SLIDECOACH_API_KEY=

# Data is created locally after startup. This package contains no user data.
SLIDECOACH_DATA=./data
# The application permits at most 10 requests per minute; use a lower value if needed.
SLIDECOACH_RPM=10
# Keep 0 for localhost HTTP; use 1 when the browser accesses your HTTPS deployment.
SLIDECOACH_SECURE_COOKIE=0
